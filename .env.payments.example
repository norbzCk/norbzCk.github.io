# ============================================================
# Real mobile-money payment provider credentials.
# Copy the relevant block into your actual environment once you have
# accounts with each provider. Nothing here is a working secret.
# See backend/app/payment_providers/README.md for setup steps and the
# reasoning behind each field.
# ============================================================

# --- M-Pesa Tanzania (Vodacom M-Pesa Open API) ---
# Register your app at https://openapiportal.m-pesa.com, activate
# "C2B Single Payment" + "Asynchronous Flow", set Response URL to:
#   https://your-backend-domain/payments/webhook/mpesa
MPESA_API_HOST=https://openapi.m-pesa.com/sandbox
MPESA_MARKET=vodacomTZN
MPESA_API_KEY=
MPESA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
MPESA_SERVICE_PROVIDER_CODE=
# Shared secret WE choose and send as X-Callback-Secret header validation.
# Vodacom's callback doesn't sign requests by default, so this only helps
# if you also restrict the endpoint by network/allowlist in production.
MPESA_CALLBACK_SECRET=change-this

# --- Airtel Money (Airtel Africa Open API) ---
# Register at https://developers.airtel.africa, request the
# "Collections"/"Merchant Payments" product, get sandbox Client ID/Secret.
AIRTEL_API_HOST=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=TZ
AIRTEL_CURRENCY=TZS
AIRTEL_CALLBACK_SECRET=change-this

# --- Tigo Pesa ---
# No self-serve sandbox exists; integrate through an aggregator (Selcom,
# ClickPesa, DPO, or AzamPay) that already has a Tigo Pesa/MIC agreement.
# Fill these in with whichever aggregator you sign with, and adjust the
# request/response field names in backend/app/payment_providers/tigopesa_service.py
# to match their actual API docs.
TIGOPESA_API_HOST=
TIGOPESA_API_KEY=
TIGOPESA_API_SECRET=
TIGOPESA_CALLBACK_SECRET=change-this
