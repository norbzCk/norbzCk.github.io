# ============================================================
# AI assistant (GlobalAIAssistant widget -> POST /ai/assistant).
# Provider priority at request time: Gemini -> OpenAI -> rule-based fallback.
# Neither is required -- with both unset, the assistant still works using the
# rule-based fallback in ai_assistant.py (grounded in the same live db context).
# ============================================================

# --- Gemini (customer-service focused: dedicated system prompt + knowledge
# base in backend/app/assistant_knowledge/, tried first) ---
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- OpenAI (general SokoLink assistant across all roles, second choice) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
